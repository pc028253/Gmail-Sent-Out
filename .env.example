# Gmail 帳號設定
# 請複製此檔案為 .env 並填寫您的資訊

# 您的 Gmail 郵箱地址
GMAIL_USER=your-email@gmail.com

# Gmail 應用程式密碼（不是您的 Gmail 密碼！）
# 如何取得應用程式密碼：
# 1. 前往 https://myaccount.google.com/security
# 2. 啟用「兩步驟驗證」
# 3. 前往「應用程式密碼」
# 4. 選擇「郵件」和「其他裝置」
# 5. 複製生成的 16 位密碼
GMAIL_APP_PASSWORD=your-16-digit-app-password

# 伺服器端口（可選，預設為 3000）
PORT=3000
